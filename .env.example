# Kopieer naar .env.local en vul je Supabase project-waarden in.
# Zie supabase/README.md voor de stappen.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side ONLY. Vraag een key aan op https://console.anthropic.com/settings/keys
# Zet deze in Netlify → Site settings → Environment variables.
# NIET in client-code, en GEEN VITE_ prefix.
ANTHROPIC_API_KEY=sk-ant-...

# Server-side (Netlify Functions) — voor JWT-verificatie op /ai-sketch en
# /admin-users. Zelfde waardes als de VITE_SUPABASE_* maar zonder
# VITE_-prefix zodat ze enkel server-side beschikbaar zijn.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service-role key voor admin operaties (gebruikers aanmaken).
# VERTROUWELIJK — geeft volledige DB-toegang die RLS omzeilt.
# UITSLUITEND server-side gebruiken, NOOIT in client-bundle.
# Te vinden in: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optioneel — zet op "true" om self-signup op /login te tonen tijdens
# ontwikkeling. In productie altijd weglaten of "false".
# VITE_ALLOW_SIGNUP=false
