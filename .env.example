# Kopieer naar .env.local en vul je Supabase project-waarden in.
# Zie supabase/README.md voor de stappen.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side ONLY. Vraag een key aan op https://console.anthropic.com/settings/keys
# Zet deze in Netlify → Site settings → Environment variables.
# NIET in client-code, en GEEN VITE_ prefix.
ANTHROPIC_API_KEY=sk-ant-...
